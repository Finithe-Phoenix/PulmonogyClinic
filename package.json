{
  "name": "pulmonogy-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",

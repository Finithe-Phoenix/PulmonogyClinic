{
  "name": "pulmonogy-clinic",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build:portal": "ng build --configuration portal",
    "dev:private": "node scripts/private-dev.mjs up",
    "dev:private:stop": "node scripts/private-dev.mjs stop",
    "test:api:local": "node scripts/private-dev.mjs test",
    "test:portal": "playwright test --config playwright.portal.config.ts",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "build:pages": "ng build --base-href /PulmonogyClinic/",
    "test": "node --test tests/*.test.ts",
    "check": "npm test && npm run build:pages && npm run test:e2e",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "oidc-client-ts": "3.5.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  }
}

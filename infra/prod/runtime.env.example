# TEMPLATE ONLY. Requires approved hosting, DB, identity, TLS and secret injection.
# Never use these placeholders as a working deployment or put real secrets here.
DB_URL=jdbc:postgresql://REPLACE_DB_HOST.invalid:5432/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.crt
DB_USER=REPLACE_UNPRIVILEGED_RUNTIME_ROLE
DB_PASSWORD=REPLACE_BY_SECRET_MANAGER_INJECTION
FLYWAY_ENABLED=false
OIDC_ISSUER_URI=https://REPLACE_IDENTITY_HOST.invalid/realms/REPLACE_REALM
OIDC_JWK_SET_URI=https://REPLACE_IDENTITY_HOST.invalid/realms/REPLACE_REALM/protocol/openid-connect/certs
OIDC_AUDIENCE=clinic-api
PORT=8080
# Do not inject MIGRATION_USER, MIGRATION_PASSWORD or owner/admin credentials.
# Port 8080 is an internal HTTP listener behind a trusted TLS ingress, not public.
# Root/SQL/HTTP debug logging must not be enabled against real data.
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_JDBC_CORE=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
